# ═══════════════════════════════════════════════════════════════════════════
# This image expects Flutter web to be pre-built on the host before running
# docker buildx. The publishAPP script in api/package.json handles this.
# Pre-built output must be present at ./build/web relative to the build context.
# ═══════════════════════════════════════════════════════════════════════════
FROM nginx:alpine AS runner

COPY build/web /usr/share/nginx/html
COPY nginx-app.conf /etc/nginx/conf.d/default.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
