# ═══════════════════════════════════════════════════════════════════════════
# This image expects Flutter web to be pre-built on the host before running
# docker buildx. The publishAPP script in api/package.json handles this.
# Pre-built output must be present at ./build/web relative to the build context.
# ═══════════════════════════════════════════════════════════════════════════
#
# Não usa a imagem `nginx:alpine`: ela traz nginx 1.31.x do repositório da
# própria nginx, e o módulo brotli do Alpine é compilado contra 1.28.x —
# binariamente incompatíveis, o nginx recusa carregar. Partindo do `alpine`,
# nginx e módulo vêm do mesmo repositório oficial do Alpine, com versão casada.
# Mesma base do Dockerfile.build-web (uso local via docker-compose) — os dois
# precisam servir os mesmos .gz/.br que scripts/precompress_web.sh gera.
FROM alpine:3.22 AS runner

# `brotli` (o binário, não só o módulo do nginx) é usado pelo entrypoint.sh
# para recomprimir um arquivo quando a substituição do placeholder de
# API_BASE_URL roda em runtime. Sem ele, `set -e` mata o entrypoint no meio e
# o nginx nunca chega a subir — faltou aqui antes e não dava pra perceber
# porque o bug do grep (--include incompatível com BusyBox) impedia esse
# caminho de código de ser alcançado.
RUN apk add --no-cache nginx nginx-mod-http-brotli brotli \
    && rm -f /etc/nginx/http.d/default.conf \
    && mkdir -p /usr/share/nginx/html

COPY build/web /usr/share/nginx/html
# Alpine inclui os server blocks de http.d (conf.d é contexto main, não http).
COPY nginx-app.conf /etc/nginx/http.d/default.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && nginx -t

EXPOSE 80

# 127.0.0.1, não `localhost`: o nginx só escuta em IPv4 (0.0.0.0:80) e o
# BusyBox wget tenta ::1 primeiro, então `localhost` dava "connection refused"
# e o container ficava eternamente unhealthy mesmo servindo normalmente.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
