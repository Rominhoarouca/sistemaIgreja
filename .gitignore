# Miscellaneous
*.env*
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Credenciais do Firebase Admin (service account).
# Diferente das apiKey do cliente, esta chave ENVIA push em nome do projeto e
# assina como administrador — nunca pode ser versionada.
*firebase-adminsdk*.json
**/serviceAccountKey.json
api/*.json.key

# UDIDs de testadores exportados do Firebase: identificam aparelhos de pessoas
# reais e mudam a cada rodada de testes.
udids*.txt
# Chave da App Store Connect API — assina como App Manager na sua conta Apple.
AuthKey_*.p8

# Dumps de banco. Contêm a base inteira, produção inclusive — nunca versionar.
backups/
*.dump

# Secrets montados no compose (service account do Firebase Admin).
secrets/
