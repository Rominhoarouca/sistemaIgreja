// Prisma Schema — Sistema Igreja (SaaS multi-tenant)
// PostgreSQL com suporte a lat/lng para geolocalização

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  LIDER
  SUPERVISOR
  COORDENADOR
  // Kids: professor da salinha. Opera apenas as salas em que está vinculado.
  KIDS
  // Kids: pai/responsável. Escopo mínimo — vê só os próprios filhos.
  RESPONSAVEL
}

/// Papel da pessoa dentro da célula. Só um vice-líder e um anfitrião por
/// célula fazem sentido, mas isso é regra de aplicação, não do banco.
enum CellMemberRole {
  MEMBRO
  VICE_LIDER
  ANFITRIAO
}

enum VisitorStatus {
  novo
  em_acompanhamento
  integrado
  inativo
}

// Gênero para relatórios demográficos. Ausência do valor (null) é exibida
// como "Não informado" — nunca inferimos o gênero a partir do nome.
enum Gender {
  MASCULINO
  FEMININO
}

enum SpiritualEventType {
  enviado_batismo
  batizado
  enviado_treinamento_lider
  concluiu_treinamento
  tornou_se_lider
}

enum MaterialFileType {
  pdf
  docx
  ppt
  video
  outro
}

enum DayOfWeek {
  segunda
  terca
  quarta
  quinta
  sexta
  sabado
  domingo
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  COMPLETE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  MANUAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ── Kids ─────────────────────────────────────────────────────────────────────
enum KidsSessionStatus {
  OPEN
  CLOSED
}

enum KidsCheckinStatus {
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

/// MANUAL = liberação sem QR nem senha, exige justificativa.
enum KidsCheckMethod {
  QR
  CODE
  MANUAL
}

enum KidsNoteKind {
  INDIVIDUAL
  CLASS
}

/// Níveis 1, 2 e 3 do alerta ao responsável.
enum KidsAlertLevel {
  INFO
  URGENT
  EMERGENCY
}

enum KidsAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum KidsChannel {
  PUSH
  WHATSAPP
  SMS
  CALL
  CRITICAL_PUSH
}

enum KidsDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum KidsTeacherRole {
  TITULAR
  AUXILIAR
}

enum GuardianRelation {
  PAI
  MAE
  AVO
  TIO
  RESPONSAVEL_LEGAL
  OUTRO
}

// ── SaaS: Church (tenant) ────────────────────────────────────────────────────
model Church {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  address   String?
  site      String?
  instagram String?
  youtube   String?
  tiktok    String?
  logoKey   String?  @map("logo_key")
  menuColor String   @default("#3F51B5") @map("menu_color")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription        Subscription?
  users               User[]
  coordenacoes        Coordenacao[]
  cellTypes           CellType[]
  cells               Cell[]
  visitors            Visitor[]
  cellMembers         CellMember[]
  cellMeetings        CellMeeting[]
  attendances         Attendance[]
  spiritualHistories  SpiritualHistory[]
  materials           Material[]
  children            Child[]
  notifications       Notification[]
  kidsRooms           KidsRoom[]
  kidsRoomTeachers    KidsRoomTeacher[]
  kidsSessions        KidsSession[]
  kidsGuardians       KidsGuardian[]
  kidsCheckins        KidsCheckin[]
  kidsNotes           KidsNote[]
  kidsAlerts          KidsAlert[]
  kidsAlertDeliveries KidsAlertDelivery[]
  deviceTokens        DeviceToken[]

  @@map("churches")
}

// ── SaaS: Plan ───────────────────────────────────────────────────────────────
model Plan {
  id          String   @id @default(uuid())
  tier        PlanTier @unique
  name        String
  description String?
  priceMonth  Int      @default(0) @map("price_month") // centavos
  priceYear   Int      @default(0) @map("price_year") // centavos
  features    String[] @default([])
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

// ── SaaS: Subscription ───────────────────────────────────────────────────────
model Subscription {
  id                     String             @id @default(uuid())
  churchId               String             @unique @map("church_id")
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus @default(TRIALING)
  billingCycle           BillingCycle       @default(MONTHLY) @map("billing_cycle")
  provider               String             @default("manual") // manual|asaas|mercadopago|stripe
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @map("external_subscription_id")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

// ── Users ───────────────────────────────────────────────────────────────────
model User {
  id            String     @id @default(uuid())
  churchId      String?    @map("church_id") // null apenas p/ SUPERADMIN
  name          String
  email         String
  password      String
  role          UserRole   @default(LIDER)
  /// Papéis adicionais acumulados pelo usuário. `role` continua sendo o papel
  /// principal (compatibilidade e ordenação); a autorização usa a união dos
  /// dois — um mesmo usuário pode ser líder, supervisor, admin e coordenador.
  roles         UserRole[] @default([])
  photoKey      String?    @map("photo_key")
  phone         String?
  address       String?
  birthDate     DateTime?  @map("birth_date")
  isMarried     Boolean    @default(false) @map("is_married")
  spouseName    String?    @map("spouse_name")
  weddingDate   DateTime?  @map("wedding_date")
  supervisorId  String?    @map("supervisor_id")
  coordenacaoId String?    @map("coordenacao_id")
  description   String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  church                Church?                 @relation(fields: [churchId], references: [id])
  cells                 Cell[]                  @relation("CellLeader")
  supervisor            User?                   @relation("SupervisorLeaders", fields: [supervisorId], references: [id])
  subordinates          User[]                  @relation("SupervisorLeaders")
  coordenacao           Coordenacao?            @relation("CoordenacaoSupervisores", fields: [coordenacaoId], references: [id])
  coordenacaoLiderada   Coordenacao?            @relation("CoordenacaoCoordinador")
  visitors              Visitor[]               @relation("LeaderVisitors")
  spiritualHistories    SpiritualHistory[]      @relation("RecordedBy")
  materials             Material[]              @relation("UploadedBy")
  refreshTokens         RefreshToken[]
  children              Child[]
  cellMembers           CellMember[]
  cellMeetings          CellMeeting[]           @relation("CreatedMeetings")
  notificationsCreated  Notification[]          @relation("NotificationCreatedBy")
  notificationsReceived NotificationRecipient[] @relation("NotificationRecipients")
  kidsRoomsTaught       KidsRoomTeacher[]       @relation("KidsTeacher")
  kidsSessionsOpened    KidsSession[]           @relation("KidsSessionOpened")
  kidsGuardianOf        KidsGuardian[]          @relation("KidsGuardian")
  kidsCheckinsMade      KidsCheckin[]           @relation("KidsCheckinBy")
  kidsNotesWritten      KidsNote[]              @relation("KidsNoteAuthor")
  kidsAlertsCreated     KidsAlert[]             @relation("KidsAlertCreatedBy")
  devices               DeviceToken[]           @relation("UserDevices")

  @@unique([churchId, email])
  @@index([churchId])
  @@index([supervisorId])
  @@index([coordenacaoId])
  @@map("users")
}

// ── Coordenacao ──────────────────────────────────────────────────────────────
model Coordenacao {
  id            String   @id @default(uuid())
  churchId      String?  @map("church_id")
  name          String
  color         String // hex color e.g. "#3F51B5"
  coordinadorId String   @unique @map("coordinador_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  church       Church? @relation(fields: [churchId], references: [id])
  coordinador  User    @relation("CoordenacaoCoordinador", fields: [coordinadorId], references: [id])
  supervisores User[]  @relation("CoordenacaoSupervisores")

  @@index([churchId])
  @@map("coordenacoes")
}

/// Criança. Nasceu como "filho declarado no perfil do usuário" e virou também a
/// ficha do módulo Kids — por isso `userId` é opcional: criança cadastrada no
/// balcão pela professora não tem responsável com conta no app.
///
/// `cellMemberId`/`visitorId` são a ponte opcional com a suíte (células). Em
/// igreja que assina só o Kids, ficam nulos e nenhuma query do módulo os usa.
model Child {
  id               String    @id @default(uuid())
  churchId         String?   @map("church_id")
  userId           String?   @map("user_id")
  cellMemberId     String?   @map("cell_member_id")
  visitorId        String?   @map("visitor_id")
  name             String
  birthDate        DateTime? @map("birth_date")
  gender           Gender?
  photoKey         String?   @map("photo_key")
  // Dados sensíveis (LGPD art. 5º, II) — nunca vão para push, WhatsApp ou export.
  allergies        String?   @db.Text
  medications      String?   @db.Text
  disabilities     String?   @db.Text
  medicalNotes     String?   @map("medical_notes") @db.Text
  authorizedPickup String?   @map("authorized_pickup") @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  church     Church?        @relation(fields: [churchId], references: [id])
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  cellMember CellMember?    @relation(fields: [cellMemberId], references: [id], onDelete: SetNull)
  visitor    Visitor?       @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  guardians  KidsGuardian[]
  checkins   KidsCheckin[]
  notes      KidsNote[]
  alerts     KidsAlert[]

  @@index([churchId])
  @@index([userId])
  @@index([churchId, name])
  @@map("children")
}

// ── Kids: salas e professores ────────────────────────────────────────────────
model KidsRoom {
  id           String   @id @default(uuid())
  churchId     String?  @map("church_id")
  name         String
  description  String?
  capacity     Int
  // Faixa etária em meses: berçário precisa distinguir 6 de 18 meses.
  minAgeMonths Int?     @map("min_age_months")
  maxAgeMonths Int?     @map("max_age_months")
  color        String   @default("#3F51B5")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  church   Church?           @relation(fields: [churchId], references: [id])
  teachers KidsRoomTeacher[]
  sessions KidsSession[]

  @@index([churchId])
  @@map("kids_rooms")
}

model KidsRoomTeacher {
  id        String          @id @default(uuid())
  churchId  String?         @map("church_id")
  roomId    String          @map("room_id")
  userId    String          @map("user_id")
  role      KidsTeacherRole @default(AUXILIAR)
  createdAt DateTime        @default(now()) @map("created_at")

  church Church?  @relation(fields: [churchId], references: [id])
  room   KidsRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User     @relation("KidsTeacher", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([churchId])
  @@index([userId])
  @@map("kids_room_teachers")
}

// ── Kids: sessão (a aula de um culto) ────────────────────────────────────────
model KidsSession {
  id               String            @id @default(uuid())
  churchId         String?           @map("church_id")
  roomId           String            @map("room_id")
  serviceDate      DateTime          @map("service_date") @db.Date
  serviceName      String            @default("Culto") @map("service_name")
  status           KidsSessionStatus @default(OPEN)
  openedById       String            @map("opened_by_id")
  openedAt         DateTime          @default(now()) @map("opened_at")
  closedById       String?           @map("closed_by_id")
  closedAt         DateTime?         @map("closed_at")
  lesson           String?
  capacityOverride Int?              @map("capacity_override")

  church   Church?       @relation(fields: [churchId], references: [id])
  room     KidsRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  openedBy User          @relation("KidsSessionOpened", fields: [openedById], references: [id])
  checkins KidsCheckin[]
  notes    KidsNote[]
  alerts   KidsAlert[]

  // Impede duas sessões concorrentes da mesma sala no mesmo culto — acontece
  // quando dois professores abrem a sala ao mesmo tempo.
  @@unique([roomId, serviceDate, serviceName])
  @@index([churchId])
  @@index([roomId, serviceDate])
  @@map("kids_sessions")
}

// ── Kids: responsáveis ───────────────────────────────────────────────────────
model KidsGuardian {
  id          String           @id @default(uuid())
  churchId    String?          @map("church_id")
  childId     String           @map("child_id")
  userId      String?          @map("user_id")
  name        String
  /// E.164 sem formatação: +5511999999999.
  phone       String
  hasWhatsapp Boolean          @default(true) @map("has_whatsapp")
  relation    GuardianRelation @default(RESPONSAVEL_LEGAL)
  isPrimary   Boolean          @default(false) @map("is_primary")
  canPickup   Boolean          @default(true) @map("can_pickup")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  church          Church?             @relation(fields: [churchId], references: [id])
  child           Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  user            User?               @relation("KidsGuardian", fields: [userId], references: [id], onDelete: SetNull)
  checkinsGiven   KidsCheckin[]       @relation("KidsCheckinGuardian")
  checkoutsTaken  KidsCheckin[]       @relation("KidsCheckoutGuardian")
  alertDeliveries KidsAlertDelivery[]

  @@index([churchId])
  @@index([childId])
  @@index([userId])
  @@index([churchId, phone])
  @@map("kids_guardians")
}

// ── Kids: check-in / check-out ───────────────────────────────────────────────
model KidsCheckin {
  id        String            @id @default(uuid())
  churchId  String?           @map("church_id")
  sessionId String            @map("session_id")
  childId   String            @map("child_id")
  status    KidsCheckinStatus @default(CHECKED_IN)
  /// Sequencial legível dentro da sessão ("K-014") — vai na etiqueta.
  badgeCode String            @map("badge_code")

  checkinAt         DateTime        @default(now()) @map("checkin_at")
  checkinById       String          @map("checkin_by_id")
  checkinMethod     KidsCheckMethod @map("checkin_method")
  checkinGuardianId String?         @map("checkin_guardian_id")

  // Senha de retirada de quem não usa o app. Só o hash é persistido; os dois
  // últimos dígitos ficam em claro para conferência visual no balcão.
  pickupCodeHash    String?   @map("pickup_code_hash")
  pickupCodeLast2   String?   @map("pickup_code_last2")
  pickupAttempts    Int       @default(0) @map("pickup_attempts")
  pickupLockedUntil DateTime? @map("pickup_locked_until")

  checkoutAt           DateTime?        @map("checkout_at")
  checkoutById         String?          @map("checkout_by_id")
  checkoutMethod       KidsCheckMethod? @map("checkout_method")
  checkoutGuardianId   String?          @map("checkout_guardian_id")
  checkoutGuardianName String?          @map("checkout_guardian_name")
  checkoutReason       String?          @map("checkout_reason")

  church           Church?       @relation(fields: [churchId], references: [id])
  session          KidsSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child            Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  checkinBy        User          @relation("KidsCheckinBy", fields: [checkinById], references: [id])
  checkinGuardian  KidsGuardian? @relation("KidsCheckinGuardian", fields: [checkinGuardianId], references: [id])
  checkoutGuardian KidsGuardian? @relation("KidsCheckoutGuardian", fields: [checkoutGuardianId], references: [id])
  notes            KidsNote[]
  alerts           KidsAlert[]

  @@unique([sessionId, childId])
  @@unique([sessionId, badgeCode])
  @@index([churchId])
  @@index([status])
  // Base do cálculo de crianças ativas no mês (métrica de cobrança).
  @@index([churchId, checkinAt])
  @@map("kids_checkins")
}

// ── Kids: anotações ──────────────────────────────────────────────────────────
model KidsNote {
  id                String       @id @default(uuid())
  churchId          String?      @map("church_id")
  sessionId         String       @map("session_id")
  kind              KidsNoteKind
  /// Null quando `kind = CLASS` (anotação geral da aula).
  childId           String?      @map("child_id")
  checkinId         String?      @map("checkin_id")
  body              String       @db.Text
  /// O professor decide se a observação vai para o responsável ou fica interna.
  visibleToGuardian Boolean      @default(true) @map("visible_to_guardian")
  authorId          String       @map("author_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  church  Church?      @relation(fields: [churchId], references: [id])
  session KidsSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child   Child?       @relation(fields: [childId], references: [id], onDelete: Cascade)
  checkin KidsCheckin? @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  author  User         @relation("KidsNoteAuthor", fields: [authorId], references: [id])

  @@index([churchId])
  @@index([sessionId, kind])
  @@index([childId])
  @@map("kids_notes")
}

// ── Kids: alertas ────────────────────────────────────────────────────────────
model KidsAlert {
  id          String          @id @default(uuid())
  churchId    String?         @map("church_id")
  sessionId   String          @map("session_id")
  childId     String          @map("child_id")
  checkinId   String?         @map("checkin_id")
  level       KidsAlertLevel
  status      KidsAlertStatus @default(OPEN)
  message     String          @db.Text
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  acknowledgedAt           DateTime? @map("acknowledged_at")
  acknowledgedByGuardianId String?   @map("acknowledged_by_guardian_id")
  resolvedAt               DateTime? @map("resolved_at")
  resolvedById             String?   @map("resolved_by_id")

  church     Church?             @relation(fields: [churchId], references: [id])
  session    KidsSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child      Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  checkin    KidsCheckin?        @relation(fields: [checkinId], references: [id], onDelete: SetNull)
  createdBy  User                @relation("KidsAlertCreatedBy", fields: [createdById], references: [id])
  deliveries KidsAlertDelivery[]

  @@index([churchId])
  @@index([sessionId, status])
  @@index([childId])
  @@map("kids_alerts")
}

/// Uma tentativa de entrega por canal. É o rastro de que a igreja tentou avisar
/// — o que importa juridicamente quando algo dá errado.
model KidsAlertDelivery {
  id                String             @id @default(uuid())
  churchId          String?            @map("church_id")
  alertId           String             @map("alert_id")
  guardianId        String?            @map("guardian_id")
  userId            String?            @map("user_id")
  channel           KidsChannel
  status            KidsDeliveryStatus @default(QUEUED)
  providerMessageId String?            @map("provider_message_id")
  error             String?            @db.Text
  attempts          Int                @default(0)
  queuedAt          DateTime           @default(now()) @map("queued_at")
  sentAt            DateTime?          @map("sent_at")
  deliveredAt       DateTime?          @map("delivered_at")
  readAt            DateTime?          @map("read_at")

  church   Church?       @relation(fields: [churchId], references: [id])
  alert    KidsAlert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  guardian KidsGuardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([alertId])
  @@index([status])
  @@index([churchId, channel, queuedAt])
  @@map("kids_alert_deliveries")
}

// ── Kids: infra de push e antifraude do QR ───────────────────────────────────
model DeviceToken {
  id            String   @id @default(uuid())
  churchId      String?  @map("church_id")
  userId        String   @map("user_id")
  token         String   @unique
  platform      String
  appVersion    String?  @map("app_version")
  criticalOptIn Boolean  @default(false) @map("critical_opt_in")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")

  church Church? @relation(fields: [churchId], references: [id])
  user   User    @relation("UserDevices", fields: [userId], references: [id], onDelete: Cascade)

  @@index([churchId])
  @@index([userId])
  @@map("device_tokens")
}

/// Nonce do QR do responsável: impede que um print do código seja reusado
/// dentro da janela de validade.
model KidsQrNonce {
  jti       String   @id
  userId    String   @map("user_id")
  usedAt    DateTime @default(now()) @map("used_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("kids_qr_nonces")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ── Localização (global, compartilhada entre igrejas) ────────────────────────
model Estado {
  id        String   @id @default(uuid())
  name      String
  uf        String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  cidades Cidade[]

  @@map("estados")
}

model Cidade {
  id        String   @id @default(uuid())
  name      String
  estadoId  String   @map("estado_id")
  latitude  Float? // Geolocation: center point of city
  longitude Float? // Geolocation: center point of city
  createdAt DateTime @default(now()) @map("created_at")

  estado  Estado   @relation(fields: [estadoId], references: [id], onDelete: Cascade)
  bairros Bairro[]

  @@unique([name, estadoId])
  @@map("cidades")
}

model Bairro {
  id        String   @id @default(uuid())
  name      String
  cidadeId  String   @map("cidade_id")
  latitude  Float? // Geolocation: center point of neighborhood
  longitude Float? // Geolocation: center point of neighborhood
  createdAt DateTime @default(now()) @map("created_at")

  cidade      Cidade       @relation(fields: [cidadeId], references: [id], onDelete: Cascade)
  cells       Cell[]
  visitors    Visitor[]
  cellMembers CellMember[]

  @@unique([name, cidadeId])
  @@map("bairros")
}

// ── Cell Types ────────────────────────────────────────────────────────────────
model CellType {
  id          String   @id @default(uuid())
  churchId    String?  @map("church_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  church Church? @relation(fields: [churchId], references: [id])
  cells  Cell[]

  @@unique([churchId, name])
  @@index([churchId])
  @@map("cell_types")
}

// ── Cells ────────────────────────────────────────────────────────────────────
model Cell {
  id          String    @id @default(uuid())
  churchId    String?   @map("church_id")
  name        String
  /// Opcional: a célula pode ser cadastrada antes de existir um líder para ela
  /// (e um líder pode existir sem célula). Ver a tela de vínculos pendentes.
  leaderId    String?   @map("leader_id")
  cellTypeId  String?   @map("cell_type_id")
  address     String
  bairroId    String?   @map("bairro_id")
  dayOfWeek   DayOfWeek @map("day_of_week")
  time        String // "HH:MM"
  maxCapacity Int       @default(20) @map("max_capacity")
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  church      Church?       @relation(fields: [churchId], references: [id])
  leader      User?         @relation("CellLeader", fields: [leaderId], references: [id])
  cellType    CellType?     @relation(fields: [cellTypeId], references: [id])
  bairro      Bairro?       @relation(fields: [bairroId], references: [id])
  members     CellMember[]
  visitors    Visitor[]
  attendances Attendance[]
  materials   Material[]
  meetings    CellMeeting[]

  @@index([churchId])
  @@index([leaderId])
  @@index([cellTypeId])
  @@index([bairroId])
  @@map("cells")
}

// ── Visitors ─────────────────────────────────────────────────────────────────
model Visitor {
  id              String        @id @default(uuid())
  churchId        String?       @map("church_id")
  name            String
  phone           String
  email           String?
  address         String?
  numero          String? // Número do endereço
  complemento     String? // Complemento do endereço
  bairroId        String?       @map("bairro_id")
  originChurch    String?       @map("origin_church")
  birthDate       DateTime?     @map("birth_date")
  gender          Gender?
  maritalStatus   String?       @map("marital_status")
  isBaptized      Boolean       @default(false) @map("is_baptized")
  knownPersonName String?       @map("known_person_name")
  interests       String[]      @default([]) @map("interests")
  status          VisitorStatus @default(novo)
  photoKey        String?       @map("photo_key")
  leaderId        String?       @map("leader_id")
  cellId          String?       @map("cell_id")
  referredById    String?       @map("referred_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  church           Church?            @relation(fields: [churchId], references: [id])
  leader           User?              @relation("LeaderVisitors", fields: [leaderId], references: [id])
  cell             Cell?              @relation(fields: [cellId], references: [id])
  bairro           Bairro?            @relation(fields: [bairroId], references: [id])
  convertedMember  CellMember?        @relation("VisitorConvertedMember")
  referredBy       Visitor?           @relation("Referrals", fields: [referredById], references: [id])
  referrals        Visitor[]          @relation("Referrals")
  attendances      Attendance[]
  spiritualHistory SpiritualHistory[]
  children         Child[]

  @@index([churchId])
  @@index([leaderId])
  @@index([cellId])
  @@index([bairroId])
  @@index([referredById])
  @@index([churchId, gender])
  @@map("visitors")
}

// ── Cell Members ─────────────────────────────────────────────────────────────
model CellMember {
  id              String         @id @default(uuid())
  churchId        String?        @map("church_id")
  cellId          String         @map("cell_id")
  name            String
  phone           String
  email           String?
  address         String?
  bairroId        String?        @map("bairro_id")
  birthDate       DateTime?      @map("birth_date")
  gender          Gender?
  maritalStatus   String?        @map("marital_status")
  roleInCell      CellMemberRole @default(MEMBRO) @map("role_in_cell")
  isBaptized      Boolean        @default(false) @map("is_baptized")
  photoKey        String?        @map("photo_key")
  leaderId        String?        @map("leader_id")
  sourceVisitorId String?        @unique @map("source_visitor_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  church             Church?            @relation(fields: [churchId], references: [id])
  cell               Cell               @relation(fields: [cellId], references: [id], onDelete: Cascade)
  bairro             Bairro?            @relation(fields: [bairroId], references: [id])
  leader             User?              @relation(fields: [leaderId], references: [id])
  sourceVisitor      Visitor?           @relation("VisitorConvertedMember", fields: [sourceVisitorId], references: [id])
  attendances        Attendance[]       @relation("MemberAttendances")
  children           Child[]
  spiritualHistories SpiritualHistory[]

  @@index([churchId])
  @@index([cellId])
  @@index([leaderId])
  @@index([bairroId])
  @@index([churchId, gender])
  @@map("cell_members")
}

// ── Cell Meetings ─────────────────────────────────────────────────────────────
model CellMeeting {
  id          String   @id @default(uuid())
  churchId    String?  @map("church_id")
  cellId      String   @map("cell_id")
  meetingDate DateTime @map("meeting_date") @db.Date
  createdById String   @map("created_by_id")
  photoKey    String?  @map("photo_key")
  /// Tema/lição ministrada no encontro.
  lesson      String?
  /// Quem ministrou. Texto livre: pode ser alguém de fora da célula.
  ministrante String?
  /// Material da célula usado como lição. Opcional — quando a lição não está
  /// no acervo, `lesson` continua sendo o texto livre.
  materialId  String?  @map("material_id")
  createdAt   DateTime @default(now()) @map("created_at")

  church    Church?   @relation(fields: [churchId], references: [id])
  cell      Cell      @relation(fields: [cellId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CreatedMeetings", fields: [createdById], references: [id])
  material  Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@unique([cellId, meetingDate])
  @@index([churchId])
  @@index([createdById])
  @@index([materialId])
  @@map("cell_meetings")
}

// ── Attendance ────────────────────────────────────────────────────────────────
model Attendance {
  id          String   @id @default(uuid())
  churchId    String?  @map("church_id")
  visitorId   String?  @map("visitor_id")
  memberId    String?  @map("member_id")
  cellId      String   @map("cell_id")
  meetingDate DateTime @map("meeting_date") @db.Date
  isPresent   Boolean  @default(true) @map("is_present")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  church  Church?     @relation(fields: [churchId], references: [id])
  visitor Visitor?    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  member  CellMember? @relation("MemberAttendances", fields: [memberId], references: [id], onDelete: Cascade)
  cell    Cell        @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@index([churchId])
  @@index([visitorId, cellId, meetingDate])
  @@index([memberId, cellId, meetingDate])
  @@index([cellId, meetingDate])
  @@map("attendances")
}

// ── Spiritual History ─────────────────────────────────────────────────────────
/// Evento espiritual de uma pessoa da célula.
///
/// A pessoa é um visitante OU um membro — exatamente um dos dois campos é
/// preenchido. Antes só existia `visitor_id`, mas quem já é membro também é
/// enviado para batismo e batizado.
model SpiritualHistory {
  id           String             @id @default(uuid())
  churchId     String?            @map("church_id")
  visitorId    String?            @map("visitor_id")
  memberId     String?            @map("member_id")
  eventType    SpiritualEventType @map("event_type")
  description  String?
  date         DateTime           @db.Date
  recordedById String             @map("recorded_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")

  church     Church?     @relation(fields: [churchId], references: [id])
  visitor    Visitor?    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  member     CellMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedBy User        @relation("RecordedBy", fields: [recordedById], references: [id])

  @@index([churchId])
  @@index([visitorId])
  @@index([memberId])
  @@index([recordedById])
  @@map("spiritual_histories")
}

// ── Materials ─────────────────────────────────────────────────────────────────
model Material {
  id           String           @id @default(uuid())
  churchId     String?          @map("church_id")
  cellId       String           @map("cell_id")
  title        String
  description  String?
  url          String
  fileType     MaterialFileType @map("file_type")
  sizeBytes    Int              @map("size_bytes")
  uploadedById String           @map("uploaded_by_id")
  uploadedAt   DateTime         @default(now()) @map("uploaded_at")

  church     Church?       @relation(fields: [churchId], references: [id])
  cell       Cell          @relation(fields: [cellId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation("UploadedBy", fields: [uploadedById], references: [id])
  meetings   CellMeeting[]

  @@index([churchId])
  @@index([cellId])
  @@index([uploadedById])
  @@map("materials")
}

// ── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id          String   @id @default(uuid())
  churchId    String?  @map("church_id")
  title       String
  body        String   @db.Text
  imageKey    String?  @map("image_key")
  youtubeUrl  String?  @map("youtube_url")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  church     Church?                 @relation(fields: [churchId], references: [id])
  createdBy  User                    @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  recipients NotificationRecipient[]

  @@index([churchId])
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipients", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}
